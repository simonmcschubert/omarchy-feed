#!/usr/bin/env bash
# Opens Feed: starts the local server if it is not running, then opens the
# Feed window, or focuses it when it is already open. The server stops by
# itself shortly after the window closes, so nothing runs in the background.
set -euo pipefail

DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=SCRIPTDIR/server-control.sh
source "$DIR/server-control.sh"
URL="http://localhost:$PORT/"

if ! running && ! start_server; then
  echo "omarchy-feed: the server did not start; see $LOG" >&2
  notify-send "Feed did not start" "See $LOG" 2>/dev/null || true
  exit 1
fi

exec omarchy-launch-or-focus "$(omarchy-webapp-window-class "$URL")" "omarchy-launch-webapp $URL"
